# Recomendações por IA (Claude). Sem a chave, o app usa a análise local.
ANTHROPIC_API_KEY=

# Open Finance via Pluggy (https://pluggy.ai). Sem as credenciais, roda em modo sandbox com dados simulados.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

PORT=8787

# Login. Gere cada usuário com: npm run hash-password -- <usuario> <senha>
# Vários usuários separados por vírgula. Sem AUTH_USERS, o login fica desligado.
AUTH_USERS=
# Chave aleatória longa para assinar a sessão (ex.: openssl rand -hex 32)
AUTH_SECRET=
